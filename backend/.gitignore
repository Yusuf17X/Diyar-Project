# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt string replace security
.grunt

# Bower dependency directory
bower_components

# node-modules
node_modules/
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Specific to your project: Don't ignore the template backend config, 
# but ignore the actual runtime env files
config.env

# Prisma artifacts (Ignore local sqlite if used, but keep schemas)
*.db
*.db-journal

# Supabase / Local storage overrides (if any local file handling is used)
/uploads
/public/uploads

# Mac / Windows OS junk files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Postman local environments (Ignore files containing raw secret keys)
docs/postman/*.postman_environment
!docs/postman/*template*.postman_environment # Keep template files if you have them

# Editor specific settings
.vscode/
.idea/
