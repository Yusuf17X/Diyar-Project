enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum MaintenanceStatus {
  SUBMITTED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum MaintenanceCategory {
  ELECTRICAL
  HVAC
  APPLIANCE
  OTHER
}

model MaintenanceTicket {
  id           String              @id @default(cuid())
  propertyId   String              @map("property_id")
  ticketNumber Int                 @unique @default(autoincrement()) @map("ticket_number")
  userId       String              @map("user_id")
  unitId       String              @map("unit_id")
  title        String
  category     MaintenanceCategory
  priority     MaintenancePriority
  status       MaintenanceStatus   @default(SUBMITTED)
  description  String
  imageUrls    String[]            @map("image_urls")
  assignedToId String?             @map("assigned_to_id")
  resolvedAt   DateTime?           @map("resolved_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt       @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id])
  reporter User     @relation("TicketReporter", fields: [userId], references: [id])
  assignee User?    @relation("TicketAssignee", fields: [assignedToId], references: [id])
  unit     Unit     @relation(fields: [unitId], references: [id])

  @@index([propertyId, status])
  @@index([propertyId, createdAt])
  @@index([userId, status])
  @@index([assignedToId, status])
  @@unique([propertyId, ticketNumber])
  @@map("maintenance_tickets")
}
